# AirAware AI Environment Configuration
# Copy this file to .env and fill in your Google Gemini API key.
# Never commit .env or expose API keys in frontend code.

# Required for AI Smart Assistant & AI-personalized plans (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Override default Gemini model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Default city loaded on first visit
DEFAULT_CITY=New Delhi
